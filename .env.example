# InferaDocs - Environment Variables Template
# Copy this file to .env and adjust values as needed
# Never commit .env files to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_HOST_PORT=5434

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/documind
SPRING_DATASOURCE_USERNAME=documind
SPRING_DATASOURCE_PASSWORD=documind

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST_PORT=6380
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6380

# =============================================================================
# MINIO (S3-compatible object storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# For production, generate RSA keys and set these values:
# openssl genrsa -out private_key.pem 2048
# openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then set JWT_PRIVATE_KEY_PEM and JWT_PUBLIC_KEY_PEM (single-line, escape newlines as \n)
JWT_ISSUER=documind-ai
JWT_AUDIENCE=documind-ai-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_APP_TITLE=InferaDocs
# Stage 3 object storage (use unique secure credentials for deployment)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=documind-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Development defaults are for local use only. Use strong unique credentials in deployments.
